{
  "name": "@arshdelight/practi",
  "version": "0.9.6",
  "description": "Local registry CLI for POP (Protocol of Practice): manage a personal, content-addressed collection of practice documents on top of @arshdelight/pop-sdk. Syncs to PractiHub.",
  "type": "module",
  "bin": {
    "practi": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "web-default"
  ],
  "license": "MIT",
  "keywords": [
    "practi",
    "practihub",
    "pop",
    "practice",
    "cli",
    "registry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arshdelight/pop.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build --workspace @arshdelight/pop-sdk",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@arshdelight/pop-sdk": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
